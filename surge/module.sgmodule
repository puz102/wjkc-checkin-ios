#!name=网际快车签到
#!desc=登录后自动抓取登录凭证，并执行每日签到。
#!category=Checkin

[MITM]
hostname = wj-kc.com, 84.wj-kc.com, ks.wjkc.xyz

[Script]
# Capture token from login response
ks-capture-token = type=http-response,pattern=^https://(wj-kc.com|84.wj-kc.com|ks.wjkc.xyz)/api/user/login,requires-body=0,script-path=https://raw.githubusercontent.com/puz102/wjkc-checkin-ios/main/surge/capture-token.js?v=20260713-2,script-update-interval=86400

# Daily checkin
ks-checkin = type=cron,cronexp=0 8,12,21 * * *,timeout=60,script-path=https://raw.githubusercontent.com/puz102/wjkc-checkin-ios/main/surge/checkin.js?v=20260713-2,script-update-interval=86400

# Token validity check
ks-token-check = type=cron,cronexp=30 8 * * *,timeout=60,script-path=https://raw.githubusercontent.com/puz102/wjkc-checkin-ios/main/surge/token-check.js?v=20260713-2,script-update-interval=86400
