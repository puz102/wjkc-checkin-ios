#!name=网际快车签到
#!desc=Capture token after login, check in immediately, and run scheduled check-ins.
#!category=Checkin

[MITM]
hostname = wj-kc.com, 84.wj-kc.com, ks.wjkc.xyz

[Script]
ks-capture-token-checkin = type=http-response,pattern=^https://(wj-kc.com|84.wj-kc.com|ks.wjkc.xyz)/api/user/login,requires-body=0,script-path=https://raw.githubusercontent.com/puz102/wjkc-checkin-ios/main/shadowrocket/capture-token-checkin.js,script-update-interval=86400
ks-checkin = type=cron,cronexp=0 8,12,21 * * *,timeout=60,script-path=https://raw.githubusercontent.com/puz102/wjkc-checkin-ios/main/shadowrocket/checkin.js,script-update-interval=86400
ks-token-check = type=cron,cronexp=30 8 * * *,timeout=60,script-path=https://raw.githubusercontent.com/puz102/wjkc-checkin-ios/main/shadowrocket/token-check.js,script-update-interval=86400
