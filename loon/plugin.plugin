[Plugin]
# Auto capture token + daily checkin
ks-capture-token = type=http-response,pattern=^https://(wj-kc.com|84.wj-kc.com|ks.wjkc.xyz)/api/user/login,requires-body=0,script-path=https://raw.githubusercontent.com/OWNER/REPO/main/loon/capture-token.js,script-update-interval=86400
ks-checkin = type=cron,cronexp=0 8,12,21 * * *,timeout=60,script-path=https://raw.githubusercontent.com/OWNER/REPO/main/loon/checkin.js,script-update-interval=86400

[MITM]
hostname = wj-kc.com, 84.wj-kc.com, ks.wjkc.xyz
